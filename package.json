{
  "name": "ddd",
  "private": true,
  "version": "0.1.0",
  "description": "DDD — De Developer Dashboard, on Node.",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "vite --config vite.config.mts",
    "dev:electron": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "smoke": "electron-vite build && DDD_SMOKE=1 electron-vite preview",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@napi-rs/keyring": "^2.0.0",
    "imapflow": "^2.0.2",
    "postal-mime": "^3.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-grid-layout": "^2.2.4",
    "rrule": "^2.8.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.3.0",
    "electron-vite": "^5.0.0",
    "typescript": "~5.8.3",
    "vite": "^7.3.6",
    "vitest": "^5.0.0"
  }
